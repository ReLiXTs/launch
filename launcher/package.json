{
  "name": "kamyshlauncher",
  "version": "1.0.0",
  "description": "Лаунчер для сервера Камышечный",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "keywords": ["minecraft", "launcher", "kamysh"],
  "author": "ReLiXTs",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "node-fetch": "^2.7.0",
    "adm-zip": "^0.5.10",
    "semver": "^7.5.4"
  },
  "build": {
    "appId": "com.kamysh.launcher",
    "productName": "Камышечный Лаунчер",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "msi",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Камышечный Лаунчер"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../server-data",
        "to": "server-data",
        "filter": ["**/*"]
      }
    ]
  }
}
