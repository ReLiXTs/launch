{
  "serverName": "Камышечный",
  "github": {
    "owner": "ReLiXTs",
    "repo": "launch",
    "branch": "main"
  },
  "minecraft": {
    "defaultVersion": "1.21.1",
    "defaultModLoader": "fabric",
    "minRam": 2048,
    "maxRam": 8192
  },
  "paths": {
    "versions": "server-data/versions",
    "mods": "server-data/mods",
    "resourcepacks": "server-data/resourcepacks",
    "config": "server-data/config",
    "shaderpacks": "server-data/shaderpacks",
    "saves": "server-data/saves",
    "datapacks": "server-data/datapacks"
  },
  "updateCheckInterval": 300000,
  "msal": {
    "_comment": "Зарегистрируйте приложение в Azure Portal (тип: Personal Microsoft accounts only), включите разрешение XboxLive.signin, и укажите client ID сюда. Подробности в README.",
    "clientId": "YOUR_AZURE_CLIENT_ID"
  }
}
